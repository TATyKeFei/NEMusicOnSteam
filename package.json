{
  "name": "nemusic-on-steam",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build-unblock.mjs && starlight watch",
    "test": "node --experimental-strip-types --test frontend/*.test.ts frontend/**/*.test.ts backend/*.test.cjs",
    "test:python": "python3 -m unittest discover -s backend -p 'test_*.py' && python3 -m unittest discover -s tools/diagnostics -p 'test_*.py'",
    "test:lua": "lua tests/backend-lifecycle.lua",
    "check": "npm run typecheck && npm test && npm run test:python && npm run test:lua",
    "typecheck": "tsc --noEmit",
    "prepare": "starlight lsp"
  },
  "devDependencies": {
    "@unblockneteasemusic/server": "0.28.0",
    "@steambrew/starlight": "^1.1.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "typescript": "^5.9.3",
    "esbuild": "^0.25.12"
  }
}